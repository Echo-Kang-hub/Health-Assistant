<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/text_chat_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_role_user"
        android:textColor="@color/color_text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/text_chat_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chat_bubble"
        android:padding="12dp"
        android:text="@string/chat_placeholder"
        android:textColor="@color/color_text_primary"
        android:textSize="13sp" />
</LinearLayout>
