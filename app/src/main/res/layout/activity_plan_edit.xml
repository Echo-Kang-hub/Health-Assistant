<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plan_edit_title"
            android:textColor="@color/color_text_primary"
            android:textSize="20sp"
            android:fontFamily="serif" />

        <EditText
            android:id="@+id/input_plan_frequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_frequency_per_day"
            android:inputType="number"
            android:background="@drawable/bg_input" />

        <EditText
            android:id="@+id/input_plan_times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_times"
            android:background="@drawable/bg_input" />

        <EditText
            android:id="@+id/input_plan_dose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_dose"
            android:background="@drawable/bg_input" />

        <Switch
            android:id="@+id/switch_plan_with_meal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
        android:text="@string/plan_with_meal" />

        <EditText
            android:id="@+id/input_plan_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_start_date"
            android:background="@drawable/bg_input" />

        <EditText
            android:id="@+id/input_plan_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_end_date"
            android:background="@drawable/bg_input" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/color_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plan_ai_title"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_plan_ai_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/plan_ai_wait"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/button_plan_ai"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/plan_ai_recommend"
                    android:backgroundTint="@color/color_surface_alt"
                    android:textColor="@color/color_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/button_plan_save"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="@string/plan_save"
            android:backgroundTint="@color/color_primary"
            android:textColor="@color/color_on_primary" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
